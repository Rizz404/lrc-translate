# Used by docker-compose.yml (production stack). Copy to .env and adjust:
#   cp .env.example .env

# Host port to publish the app container on. Point your Plesk domain's
# proxy rule at 127.0.0.1:<this port>.
APP_PORT=8080

# Which MT backend handles translate: "localllm" (your own self-hosted
# OpenAI-compatible server — free/unlimited, much more natural/lyric-like
# output), "gemini" (Google AI Studio — same LLM-quality output, but
# free-tier rate limited/quota'd), or "libretranslate" (self-hosted, free,
# fairly literal output).
#
# KISS priority (2026-08-31): leave this UNSET (blank/removed) to
# auto-prefer localllm whenever LOCAL_LLM_URL below is filled in, then
# gemini whenever GEMINI_API_KEY is filled in, falling back to
# libretranslate only if both are empty — that's the recommended setup.
# Set it explicitly only to force one provider regardless of what's
# configured, e.g. TRANSLATE_PROVIDER=libretranslate to recover fast if
# Gemini's daily quota runs out or your local server/tunnel goes down mid-
# session (restart required either way — this is a startup-time choice, not
# an automatic runtime retry).
# Scrape+align (a separate, manual, last-resort import feature — see
# ScrapePanel in the frontend) is unaffected by this setting either way.
TRANSLATE_PROVIDER=

# --- localllm provider (preferred when LOCAL_LLM_URL is set, see
# TRANSLATE_PROVIDER above) ---
# Your own self-hosted OpenAI-compatible chat completions server (LM Studio,
# Ollama's OpenAI shim, etc.), usually reached over a tunnel (e.g. ngrok)
# since it isn't publicly routable on its own — e.g.
# https://xxxx.ngrok-free.app (no trailing /v1).
LOCAL_LLM_URL=
# Only needed if the server requires an Authorization: Bearer token (LM
# Studio's "require API key" setting).
LOCAL_LLM_API_KEY=
# Must match the model's "id" as reported by the server's GET /v1/models.
LOCAL_LLM_MODEL=Qwen3.6 35B A3B Uncensored HauhauCS Aggressive Q5 K P (modified)

# --- gemini provider (preferred when LOCAL_LLM_URL is empty but this is
# set, see TRANSLATE_PROVIDER above) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- libretranslate provider (last-resort fallback when neither above is
# configured) ---
# Only needed if you point LIBRETRANSLATE_URL elsewhere — the self-hosted
# libretranslate service in this stack needs no key.
LIBRETRANSLATE_API_KEY=

# Comma-separated language codes to restrict LibreTranslate's downloaded
# models, e.g. "ja,id,en". Must NOT be left empty — an empty (as opposed to
# truly unset) value crashes LibreTranslate on every boot, see
# docker-compose.yml's comment on this var. Defaults to "ja,en,id" if unset.
LT_LOAD_ONLY=

# LibreTranslate's own worker thread count. Keep roughly matched to
# maxConcurrentTranslations in backend/internal/httpapi/translate_handler.go
# — pushing this higher than your host's real CPU headroom causes
# contention instead of speedup. Defaults to 3 if unset.
LT_THREADS=

# Only matters if you call the API from a different origin than the app
# itself; same-origin use (the normal case) ignores this.
ALLOWED_ORIGIN=http://localhost:8080
