# Used by docker-compose.yml (production stack). Copy to .env and adjust:
#   cp .env.example .env

# Host port to publish the app container on. Point your Plesk domain's
# proxy rule at 127.0.0.1:<this port>.
APP_PORT=8080

# Which MT backend handles translate: "gemini" (Google AI Studio — LLM, much
# more natural/lyric-like output) or "libretranslate" (self-hosted, free,
# fairly literal output).
#
# KISS priority (2026-08-26): leave this UNSET (blank/removed) to
# auto-prefer gemini whenever GEMINI_API_KEY below is filled in, falling
# back to libretranslate only if it's empty — that's the recommended setup.
# Set it explicitly only to force one provider regardless of key presence,
# e.g. TRANSLATE_PROVIDER=libretranslate to recover fast if Gemini's daily
# quota runs out mid-session (restart required either way — this is a
# startup-time choice, not an automatic runtime retry).
# Scrape+align (a separate, manual, last-resort import feature — see
# ScrapePanel in the frontend) is unaffected by this setting either way.
TRANSLATE_PROVIDER=

# --- gemini provider (preferred when set, see TRANSLATE_PROVIDER above) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- libretranslate provider (fallback when GEMINI_API_KEY is empty) ---
# Only needed if you point LIBRETRANSLATE_URL elsewhere — the self-hosted
# libretranslate service in this stack needs no key.
LIBRETRANSLATE_API_KEY=

# Comma-separated language codes to restrict LibreTranslate's downloaded
# models, e.g. "ja,id,en". Must NOT be left empty — an empty (as opposed to
# truly unset) value crashes LibreTranslate on every boot, see
# docker-compose.yml's comment on this var. Defaults to "ja,en,id" if unset.
LT_LOAD_ONLY=

# LibreTranslate's own worker thread count. Keep roughly matched to
# maxConcurrentTranslations in backend/internal/httpapi/translate_handler.go
# — pushing this higher than your host's real CPU headroom causes
# contention instead of speedup. Defaults to 3 if unset.
LT_THREADS=

# Only matters if you call the API from a different origin than the app
# itself; same-origin use (the normal case) ignores this.
ALLOWED_ORIGIN=http://localhost:8080
