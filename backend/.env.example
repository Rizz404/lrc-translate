PORT=8080

# "sqlite" is the only driver wired up so far. Switching to postgres/mysql
# later needs a new case in internal/db/db.go plus the matching DB_DSN format.
DB_DRIVER=sqlite
DB_DSN=data/db.sqlite

LRCLIB_BASE_URL=https://lrclib.net/api

# Public instance by default; self-host via `docker compose up` (see
# ../docker-compose.yml) and point this at http://localhost:5000 if you hit
# rate limits.
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

ALLOWED_ORIGIN=http://localhost:5173
