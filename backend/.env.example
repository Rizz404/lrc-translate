PORT=8080

# "sqlite" is the only driver wired up so far. Switching to postgres/mysql
# later needs a new case in internal/db/db.go plus the matching DB_DSN format.
DB_DRIVER=sqlite
DB_DSN=data/db.sqlite

LRCLIB_BASE_URL=https://lrclib.net/api

# Which MT backend handleTranslateTrack uses. Leave blank to auto-resolve:
# localllm (if LOCAL_LLM_URL is set) -> gemini (if GEMINI_API_KEY is set) ->
# libretranslate. Set explicitly ("localllm" | "gemini" | "libretranslate")
# to force one provider regardless of what's configured below.
TRANSLATE_PROVIDER=

# --- localllm provider (preferred when LOCAL_LLM_URL is set — see
# TRANSLATE_PROVIDER above) ---
# A self-hosted OpenAI-compatible chat completions server (LM Studio,
# Ollama's OpenAI shim, etc.), usually reached over a tunnel (e.g. ngrok)
# since it isn't publicly routable on its own — e.g.
# https://xxxx.ngrok-free.app (no trailing /v1). Free/unlimited since it
# runs on your own hardware, but only reachable while that machine + tunnel
# are up.
LOCAL_LLM_URL=
# Only needed if the server requires an Authorization: Bearer token (LM
# Studio's "require API key" setting).
LOCAL_LLM_API_KEY=
# Must match the model's "id" as reported by the server's GET /v1/models —
# for LM Studio that's the exact string shown for the loaded model/preset.
LOCAL_LLM_MODEL=Qwen3.6 35B A3B Uncensored HauhauCS Aggressive Q5 K P (modified)

# --- gemini provider (fallback when LOCAL_LLM_URL is empty but this is set)
# ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- libretranslate provider (last-resort fallback when neither above is
# configured) ---
# Public instance by default; self-host via `docker compose up` (see
# ../docker-compose.yml) and point this at http://localhost:5000 if you hit
# rate limits.
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

ALLOWED_ORIGIN=http://localhost:5173
